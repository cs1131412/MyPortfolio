# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/Portfolio?retryWrites=true&w=majority
# Optional: only if Atlas "mongodb+srv" addresses fail to resolve (e.g. querySrv errors)
# DNS_SERVER=8.8.8.8
